{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tidewell-dev",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "--filter", "@rajs8952/web", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "tidewell-prod",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "--filter", "@rajs8952/web", "exec", "next", "start"],
      "port": 3001,
      "autoPort": true
    }
  ]
}
