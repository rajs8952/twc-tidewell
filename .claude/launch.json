{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "tidewell-dev",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "@rajs8952/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "tidewell-prod",
      "runtimeExecutable": "corepack",
      "runtimeArgs": [
        "pnpm",
        "--filter",
        "@rajs8952/web",
        "exec",
        "next",
        "start",
        "-p",
        "3001"
      ],
      "port": 3001
    }
  ]
}
