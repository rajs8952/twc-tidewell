{
  "expo": {
    "name": "OmniWell",
    "slug": "omniwell",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "omniwell",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.omniwellhealth.omniwell",
      "supportsTablet": false
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EDF4F3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.omniwellhealth.omniwell"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EDF4F3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "OmniWell uses your photos only when you choose one to send to your wellness team in a chat.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#2189D6"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "backgroundColor": "#F6F9F8",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3d929974-3370-4d35-a9c1-b01d25145552"
      }
    },
    "owner": "rajs4319"
  }
}
