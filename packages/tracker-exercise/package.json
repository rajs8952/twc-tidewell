{
  "name": "@rajs8952/tracker-exercise",
  "version": "0.0.1",
  "description": "Exercise tracker: activities, intensity and MET-based calorie estimates.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rajs8952/twc-tidewell.git",
    "directory": "packages/tracker-exercise"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.tsx"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        }
      },
      "./*": {
        "import": {
          "types": "./dist/*.d.mts",
          "default": "./dist/*.mjs"
        },
        "require": {
          "types": "./dist/*.d.ts",
          "default": "./dist/*.js"
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@rajs8952/core": "workspace:*",
    "@rajs8952/ui": "workspace:*",
    "lucide-react": "^0.451.0"
  },
  "peerDependencies": {
    "framer-motion": "^11.0.0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@rajs8952/config-eslint": "workspace:*",
    "@rajs8952/config-typescript": "workspace:*",
    "@types/react": "^18.3.11",
    "eslint": "^8.57.1",
    "framer-motion": "^11.11.1",
    "react": "18.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.6.2"
  }
}
