{
  "name": "@rajs8952/storage",
  "version": "0.0.0",
  "description": "TrackerStorage adapters for the OmniWell trackers: in-memory, localStorage, REST and Supabase.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rajs8952/twc-tidewell.git",
    "directory": "packages/storage"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./supabase": "./src/supabase.ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        }
      },
      "./supabase": {
        "import": {
          "types": "./dist/supabase.d.mts",
          "default": "./dist/supabase.mjs"
        },
        "require": {
          "types": "./dist/supabase.d.ts",
          "default": "./dist/supabase.js"
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint src --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@rajs8952/core": "workspace:*"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@rajs8952/config-eslint": "workspace:*",
    "@rajs8952/config-typescript": "workspace:*",
    "@supabase/supabase-js": "^2.45.4",
    "eslint": "^8.57.1",
    "tsup": "^8.5.0",
    "typescript": "^5.6.2",
    "vitest": "^3.2.7"
  }
}
