{
  "name": "@rajs8952/core",
  "version": "0.1.0",
  "description": "OmniWell domain logic: date and streak math, tracker models, validators and the storage interfaces. No React, no I/O.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rajs8952/twc-tidewell.git",
    "directory": "packages/core"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        },
        "require": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        }
      },
      "./*": {
        "import": {
          "types": "./dist/*.d.mts",
          "default": "./dist/*.mjs"
        },
        "require": {
          "types": "./dist/*.d.ts",
          "default": "./dist/*.js"
        }
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0"
  },
  "devDependencies": {
    "@rajs8952/config-eslint": "workspace:*",
    "@rajs8952/config-typescript": "workspace:*",
    "eslint": "^8.57.1",
    "tsup": "^8.5.0",
    "typescript": "^5.6.2",
    "vitest": "^3.2.7"
  }
}
